<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This is a Wear OS app: only ever installed on watches. -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.PDXWear"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- Standalone: all data (favorites/recent stops/arrivals) is fetched and
             managed on the watch itself; the phone app is not required. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true"/>

        <activity
            android:name=".wear.WearMainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:configChanges="screenSize|orientation|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Stand-alone "Next departure" tile: shows a per-minute countdown to the
             soonest arrival at the watch's first favorite stop. -->
        <service
            android:name=".wear.tile.FavoriteArrivalsTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER"/>
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:value="@mipmap/ic_launcher"/>
        </service>
    </application>
</manifest>